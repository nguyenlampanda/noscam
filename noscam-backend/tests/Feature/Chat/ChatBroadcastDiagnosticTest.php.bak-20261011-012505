<?php

namespace Tests\Feature\Chat;

use App\Models\ChatConversation;
use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Facades\Broadcast;
use Laravel\Sanctum\Sanctum;
use Tests\TestCase;

class ChatBroadcastDiagnosticTest extends TestCase
{
    use RefreshDatabase;

    public function test_diagnose_private_channel_authorization(): void
    {
        $owner = User::factory()->create(['role' => 'user']);
        $other = User::factory()->create(['role' => 'user']);
        $moderator = User::factory()->create(['role' => 'moderator']);

        $conversation = ChatConversation::create([
            'customer_id' => $owner->id,
        ]);

        config([
            'broadcasting.default' => 'reverb',
            'broadcasting.connections.reverb.key' => 'test-reverb-key',
            'broadcasting.connections.reverb.secret' => 'test-reverb-secret',
            'broadcasting.connections.reverb.app_id' => 'test-reverb-app',
        ]);

        $driver = Broadcast::connection('reverb');

        fwrite(STDOUT, sprintf(
            "\nBroadcast driver: %s | Registered channels: %s\n",
            get_class($driver),
            implode(', ', array_keys($driver->getChannels()))
        ));

        $channels = $driver->getChannels();
        $callback = $channels['chat.{conversationId}'] ?? null;

        $this->assertNotNull($callback, 'Chat channel callback missing');

        foreach ([
            'owner' => $owner,
            'other' => $other,
            'moderator' => $moderator,
        ] as $label => $user) {
            $callbackResult = $callback($user, $conversation->id);

            Sanctum::actingAs($user);

            $response = $this->postJson('/api/broadcasting/auth', [
                'socket_id' => '1234.5678',
                'channel_name' => 'private-chat.'.$conversation->id,
            ]);

            fwrite(STDOUT, sprintf(
                "\n%s: user_id=%d role=%s owner_id=%d callback=%s HTTP=%d response_keys=%s\n",
                $label,
                $user->id,
                $user->role,
                $owner->id,
                var_export($callbackResult, true),
                $response->status(),
                substr(str_replace(["\n", "\r"], ' ', $response->getContent()), 0, 160)
            ));
        }

        $this->assertTrue(true);
    }
}
