import { useEffect, useState } from 'react'
import { Link } from 'react-router-dom'
import Container from '../layout/Container'
import { getCommunityPosts } from '../../services/communityPostService'

export default function CommunityFeed() {
  const [posts, setPosts] = useState([])
  const [page, setPage] = useState(1)
  const [pagination, setPagination] = useState({})
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState('')

  useEffect(() => {
    const controller = new AbortController()

    async function load() {
      setLoading(true)
      setError('')

      try {
        const result = await getCommunityPosts(page, {
          signal: controller.signal,
        })

        if (!controller.signal.aborted) {
          setPosts(result.posts)
          setPagination(result.pagination)
        }
      } catch (err) {
        if (!controller.signal.aborted) {
          setError(err.message || 'Không thể tải bảng tin.')
        }
      } finally {
        if (!controller.signal.aborted) {
          setLoading(false)
        }
      }
    }

    load()
    return () => controller.abort()
  }, [page])

  return (
    <section className="bg-slate-50 py-14 sm:py-20">
      <Container>
        <div className="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p className="text-sm font-semibold text-blue-600">
              CỘNG ĐỒNG NOSCAM
            </p>
            <h2 className="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
              Chia sẻ để cùng nhau cảnh giác
            </h2>
            <p className="mt-4 max-w-2xl text-slate-600">
              Khám phá những trường hợp được cộng đồng gửi đến
              và đã qua kiểm duyệt.
            </p>
          </div>

          <Link
            to="/report"
            className="inline-flex shrink-0 items-center justify-center rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-blue-700"
          >
            Chia sẻ câu chuyện của bạn →
          </Link>
        </div>

        {loading ? (
          <div className="mt-9 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {[1, 2, 3].map((item) => (
              <div
                key={item}
                className="h-48 animate-pulse rounded-2xl bg-slate-200"
              />
            ))}
          </div>
        ) : error ? (
          <div className="mt-9 rounded-2xl border border-red-100 bg-white p-8">
            <p className="font-semibold text-slate-900">
              Chưa thể tải bảng tin
            </p>
            <p className="mt-2 text-sm text-slate-600">{error}</p>
            <button
              type="button"
              onClick={() => setPage((current) => current)}
              className="mt-4 text-sm text-blue-600"
            >
              Vui lòng tải lại trang để thử lại
            </button>
          </div>
        ) : posts.length === 0 ? (
          <div className="mt-9 rounded-3xl border border-dashed border-blue-200 bg-white px-6 py-14 text-center">
            <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-50 text-3xl">
              ✍
            </div>
            <h3 className="mt-5 text-xl font-bold text-slate-900">
              Hãy là người đầu tiên chia sẻ
            </h3>
            <p className="mx-auto mt-3 max-w-lg text-sm leading-7 text-slate-600">
              Cộng đồng đang chờ những câu chuyện và cảnh báo
              thực tế. Bài gửi sẽ được kiểm duyệt trước khi xuất hiện.
            </p>
            <Link
              to="/report"
              className="mt-6 inline-flex rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white hover:bg-blue-700"
            >
              Gửi báo cáo cộng đồng
            </Link>
          </div>
        ) : (
          <>
            <div className="mt-9 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {posts.map((post) => (
                <article
                  key={post.id}
                  className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
                >
                  <span className="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">
                    Đã kiểm duyệt
                  </span>

                  <h3 className="mt-5 text-lg font-bold text-slate-900">
                    {post.category || 'Cảnh báo từ cộng đồng'}
                  </h3>

                  <p className="mt-3 text-sm leading-6 text-slate-600">
                    Một báo cáo đã được tiếp nhận và duyệt.
                    Nội dung chi tiết chưa được công khai.
                  </p>

                  <div className="mt-6 border-t border-slate-100 pt-4 text-xs text-slate-500">
                    Mã báo cáo #{post.id}
                    {post.published_at && (
                      <span className="ml-3">
                        {new Date(post.published_at).toLocaleDateString('vi-VN')}
                      </span>
                    )}
                  </div>
                </article>
              ))}
            </div>

            <div className="mt-8 flex items-center justify-center gap-4">
              <button
                type="button"
                disabled={page <= 1}
                onClick={() => setPage((current) => current - 1)}
                className="rounded-lg border border-slate-300 px-4 py-2 text-sm disabled:opacity-40"
              >
                Trang trước
              </button>
              <span className="text-sm text-slate-600">
                Trang {pagination.current_page || page}/{pagination.last_page || 1}
              </span>
              <button
                type="button"
                disabled={page >= (pagination.last_page || 1)}
                onClick={() => setPage((current) => current + 1)}
                className="rounded-lg border border-slate-300 px-4 py-2 text-sm disabled:opacity-40"
              >
                Trang sau
              </button>
            </div>
          </>
        )}
      </Container>
    </section>
  )
}
