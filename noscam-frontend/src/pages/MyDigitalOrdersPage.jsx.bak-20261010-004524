import { useEffect, useState } from 'react'
import { Link, useNavigate } from 'react-router-dom'
import customerService, {
  getCustomerToken,
} from '../services/customerService'

const statuses = {
  pending: 'Chờ xử lý',
  processing: 'Đang xử lý',
  in_progress: 'Đang thực hiện',
  completed: 'Hoàn thành',
  cancelled: 'Đã hủy',
  rejected: 'Từ chối',
  failed: 'Thất bại',
}

const payments = {
  unpaid: 'Chưa thanh toán',
  paid: 'Đã thanh toán',
  pending: 'Đang chờ thanh toán',
  refunded: 'Đã hoàn tiền',
}

function dateTime(value) {
  if (!value) return '—'
  const date = new Date(value)
  return Number.isNaN(date.getTime())
    ? '—'
    : date.toLocaleString('vi-VN')
}

function money(value) {
  if (value === null || value === undefined) {
    return 'Chờ báo giá'
  }
  return `${Number(value).toLocaleString('vi-VN')} ₫`
}

export default function MyDigitalOrdersPage() {
  const navigate = useNavigate()
  const [orders, setOrders] = useState([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState('')
  const [page, setPage] = useState(1)
  const [lastPage, setLastPage] = useState(1)
  const [selected, setSelected] = useState(null)
  const [detailLoading, setDetailLoading] = useState(false)
  const [detailError, setDetailError] = useState('')

  useEffect(() => {
    if (!getCustomerToken()) {
      navigate('/login', {
        replace: true,
        state: { from: '/my-digital-orders' },
      })
      return
    }

    let active = true

    setLoading(true)
    setError('')

    customerService.digitalOrders(page)
      .then((response) => {
        if (!active) return
        setOrders(Array.isArray(response?.data) ? response.data : [])
        setLastPage(Math.max(1, Number(response?.last_page) || 1))
      })
      .catch((err) => {
        if (!active) return
        setError(err?.message || 'Không tải được đơn dịch vụ số.')
        if (err?.status === 401) {
          navigate('/login', { replace: true })
        }
      })
      .finally(() => {
        if (active) setLoading(false)
      })

    return () => {
      active = false
    }
  }, [navigate, page])

  async function viewDetail(id) {
    setSelected(null)
    setDetailError('')
    setDetailLoading(true)

    try {
      const response = await customerService.digitalOrder(id)
      setSelected(response?.data || null)
      if (!response?.data) {
        setDetailError('Không tìm thấy thông tin đơn hàng.')
      }
    } catch (err) {
      setDetailError(err?.message || 'Không tải được chi tiết đơn.')
    } finally {
      setDetailLoading(false)
    }
  }

  return (
    <main className="min-h-screen bg-slate-50 px-4 py-10">
      <div className="mx-auto max-w-5xl">
        <div className="mb-7 flex flex-wrap items-center justify-between gap-4">
          <div>
            <p className="text-sm font-bold text-blue-600">NoScam.vn</p>
            <h1 className="mt-2 text-3xl font-black text-slate-950">
              Đơn dịch vụ số của tôi
            </h1>
            <p className="mt-2 text-sm text-slate-500">
              Theo dõi các yêu cầu đã gửi và trạng thái xử lý.
            </p>
          </div>

          <Link
            to="/digital-services"
            className="rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white hover:bg-blue-700"
          >
            Xem dịch vụ số
          </Link>
        </div>

        {error && (
          <p role="alert" className="mb-5 rounded-xl bg-red-50 p-4 text-red-700">
            {error}
          </p>
        )}

        {loading ? (
          <p className="rounded-2xl bg-white p-6">Đang tải đơn hàng...</p>
        ) : orders.length === 0 && !error ? (
          <div className="rounded-2xl border bg-white p-8 text-center">
            Bạn chưa có đơn dịch vụ số nào.
          </div>
        ) : (
          <div className="space-y-4">
            {orders.map((order) => (
              <article
                key={order.id}
                className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
              >
                <div className="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <p className="text-sm font-bold text-blue-600">
                      Đơn #{order.id}
                    </p>
                    <h2 className="mt-1 text-lg font-bold text-slate-900">
                      {order.service?.name || 'Dịch vụ số'}
                    </h2>
                    <p className="mt-2 text-sm text-slate-500">
                      Ngày tạo: {dateTime(order.created_at)}
                    </p>
                    <p className="mt-2 text-sm text-slate-700">
                      Giá trị: {money(order.amount_vnd)}
                    </p>
                    <p className="mt-1 text-sm text-slate-700">
                      Xử lý: {statuses[order.status] || order.status}
                    </p>
                    <p className="mt-1 text-sm text-slate-700">
                      Thanh toán: {payments[order.payment_status] || order.payment_status}
                    </p>
                  </div>

                  <button
                    type="button"
                    onClick={() => viewDetail(order.id)}
                    disabled={detailLoading}
                    className="rounded-xl border border-blue-200 px-4 py-2 text-sm font-bold text-blue-700 hover:bg-blue-50 disabled:opacity-50"
                  >
                    Xem chi tiết
                  </button>
                </div>
              </article>
            ))}
          </div>
        )}

        {!loading && lastPage > 1 && (
          <div className="mt-6 flex items-center justify-center gap-4">
            <button
              type="button"
              disabled={page <= 1}
              onClick={() => setPage((p) => p - 1)}
              className="rounded-xl border bg-white px-4 py-2 disabled:opacity-40"
            >
              Trang trước
            </button>
            <span className="text-sm text-slate-600">
              {page} / {lastPage}
            </span>
            <button
              type="button"
              disabled={page >= lastPage}
              onClick={() => setPage((p) => p + 1)}
              className="rounded-xl border bg-white px-4 py-2 disabled:opacity-40"
            >
              Trang sau
            </button>
          </div>
        )}

        {(selected || detailLoading || detailError) && (
          <section className="mt-8 rounded-2xl border border-blue-200 bg-white p-6">
            <div className="flex items-center justify-between gap-3">
              <h2 className="text-xl font-black">
                Chi tiết yêu cầu
              </h2>
              <button
                type="button"
                onClick={() => {
                  setSelected(null)
                  setDetailError('')
                }}
                className="text-sm font-bold text-slate-500"
              >
                Đóng
              </button>
            </div>

            {detailLoading && <p className="mt-4">Đang tải...</p>}
            {detailError && (
              <p role="alert" className="mt-4 text-red-600">{detailError}</p>
            )}

            {selected && (
              <div className="mt-5 space-y-3 text-sm">
                <p><strong>Mã đơn:</strong> #{selected.id}</p>
                <p><strong>Dịch vụ:</strong> {selected.service?.name || '—'}</p>
                <p><strong>Trạng thái:</strong> {statuses[selected.status] || selected.status}</p>
                <p><strong>Thanh toán:</strong> {payments[selected.payment_status] || selected.payment_status}</p>
                <p><strong>Số tiền:</strong> {money(selected.amount_vnd)}</p>

                <h3 className="pt-3 font-bold">Thông tin đã gửi</h3>
                {Object.entries(selected.request_data || {}).map(([key, value]) => (
                  <div key={key} className="rounded-lg bg-slate-50 p-3">
                    <strong className="break-all">{key}:</strong>{' '}
                    <span className="break-words">{String(value)}</span>
                  </div>
                ))}

                {selected.customer_note && (
                  <p className="break-words">
                    <strong>Ghi chú:</strong> {selected.customer_note}
                  </p>
                )}
              </div>
            )}
          </section>
        )}
      </div>
    </main>
  )
}
